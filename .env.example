# DATABASE_URL: Neon Serverless PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET: Strong random secret used to sign JWT auth tokens
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
SUPER_ADMIN_PASSWORD="REPLACE_WITH_STRONG_UNIQUE_PASSWORD"

# APP_URL: Public URL of the application for links and emails
APP_URL="http://localhost:3000"

# UPLOAD_DIR: Local object-storage fallback directory outside public web root
UPLOAD_DIR="./storage/uploads"

# S3-compatible object storage configuration (e.g. Neon Storage)
AWS_ENDPOINT_URL_S3="https://your-neon-storage-endpoint.aws.neon.tech"
AWS_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
S3_BUCKET="assets"

# Nodemailer SMTP configuration (falls back to Ethereal/logged preview if empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TaskUpCard <no-reply@taskupcard.app>"
